# Copy to `.env.local` and fill in values. See README.md (Supabase Setup, Admin, CRM sections).
# `.env.local` is gitignored; keep secrets out of git.

# Production site URL (canonical links, Stripe redirects, sitemap)
NEXT_PUBLIC_SITE_URL=https://bossworkwear.au

# Project timezone — Australia/Perth (AWST, UTC+8). Used by Node scripts and SSR date logic.
TZ=Australia/Perth

# Google Analytics 4 — Admin → Data streams → Measurement ID (G-XXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional: GA4 Admin → Property settings → Property ID (numeric) for admin deep links
# NEXT_PUBLIC_GA4_PROPERTY_ID=

# Google Search Console — HTML tag verification (content value only, not the full meta tag)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recommended for admin lists, stock, invoice PDFs, legacy password migration, etc.
SUPABASE_SERVICE_ROLE_KEY=

# After rotating Supabase keys: npm run sync:vercel-supabase-env, then push to main for a new Vercel build.
# See docs/SUPABASE_VERCEL_ENV.md
# STOREFRONT_CATALOG_MIN_PRODUCTS=100
# STOREFRONT_CATALOG_ALERT_EMAIL=account@bossworkwear.au

# Postgres direct URI for scripts/backup-supabase-db.sh (Dashboard → Database → Connection string → URI)
# SUPABASE_DB_DIRECT_URL=postgresql://postgres.[ref]:[PASSWORD]@....supabase.com:5432/postgres

# Google reCAPTCHA v2 (email sign-up only) — https://www.google.com/recaptcha/admin
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# Local dev only — skip reCAPTCHA verify when the widget cannot load (never set on Vercel production)
# RECAPTCHA_DEV_BYPASS=1

# Customer OAuth (Google, Microsoft/Azure, Apple): enable in Supabase Dashboard → Authentication.
# Redirect URLs must include: https://your-domain/auth/callback, http://localhost:3000/auth/callback,
# and http://127.0.0.1:3000/auth/callback if you test with 127.0.0.1
# See docs/SUPABASE_AUTH_SETUP.md

# Admin login (required in production)
BOSS_ADMIN_PASSWORD=

# Stripe (checkout)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Dashboard → Developers → Webhooks → endpoint https://bossworkwear.au/api/stripe/webhook (checkout.session.completed)
# STRIPE_WEBHOOK_SECRET=

# Optional: social links (footer defaults to Boss Workwear Facebook if unset)
# NEXT_PUBLIC_FACEBOOK_URL=
# NEXT_PUBLIC_INSTAGRAM_URL=

# Xero (OAuth + automatic sales invoices; see docs/XERO_SETUP.md)
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_REDIRECT_URI=   # optional; default {NEXT_PUBLIC_SITE_URL}/api/xero/callback
# XERO_SALES_ACCOUNT_CODE=200   # Revenue/sales account code in your Xero chart of accounts
# XERO_BANK_ACCOUNT_CODE=       # Bank account code for recording Stripe payments (Chart of accounts → Bank)

# Storefront live chat — virtual assistant (English FAQ + OpenAI; see lib/storefront-chat-assistant.ts)
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# STOREFRONT_CHAT_ASSISTANT_ENABLED=1
# Set STOREFRONT_CHAT_ASSISTANT_ENABLED=0 to disable auto-replies entirely.

# Optional: CRM email (Resend), Twilio SMS, cron — see README.md
# ALLOW_DEBUG_ROUTES=1
