# Copy to `.env.local` and fill in values. See README.md (Supabase Setup, Admin, CRM sections).
# `.env.local` is gitignored; keep secrets out of git.

# Production site URL (canonical links, Stripe redirects, sitemap) — e.g. https://www.bossworkwear.com.au
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recommended for admin lists, stock, invoice PDFs, etc.
SUPABASE_SERVICE_ROLE_KEY=

# Admin login (required in production)
BOSS_ADMIN_PASSWORD=

# Stripe (checkout)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional: social links (footer defaults to Boss Workwear Facebook if unset)
# NEXT_PUBLIC_FACEBOOK_URL=
# NEXT_PUBLIC_INSTAGRAM_URL=

# Optional: CRM email (Resend), Twilio SMS, cron — see README.md
# ALLOW_DEBUG_ROUTES=1
